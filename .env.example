# ===================================================================
# GLPI MCP Server - Exemplo de Configuração de Ambiente
# ===================================================================
#
# Escolha UM dos métodos de autenticação abaixo, dependendo da sua versão do GLPI.
#

# -------------------------------------------------------------------
# Método 1: GLPI v11+ (Recomendado: Usuário/Senha + OAuth2)
# -------------------------------------------------------------------

# URL base da sua instancia GLPI (sem /api.php ou /apirest.php no final)
GLPI_URL=https://<seu-glpi-v11-aqui>

# Versão da API (use 11 ou superior)
GLPI_API_VERSION=11

# Credenciais de um usuário GLPI com permissão de API
GLPI_USERNAME=
GLPI_PASSWORD=

# Credenciais do "Cliente OAuth" registrado no GLPI (para Password Grant)
# Vá em Configurar > Geral > Clientes OAuth para criar
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=


# -------------------------------------------------------------------
# Método 2: GLPI v10 e Anteriores (Legado: Token Pessoal + App Token)
# -------------------------------------------------------------------
#
# Para usar este método, comente ou apague as variáveis do Método 1 e
# preencha as variáveis abaixo.
#
# GLPI_URL=https://<seu-glpi-v10-aqui>
# GLPI_API_VERSION=10
#
# # Token de Aplicação (API Token) - gerado nas configurações da API do GLPI
# GLPI_APP_TOKEN=

# Also send tokens in the query string (only for WAFs that strip custom headers)
# GLPI_TOKENS_IN_QUERY=true
#
# # Token Pessoal do Usuário (User Token) - gerado nas preferências do seu usuário
# GLPI_USER_TOKEN=
